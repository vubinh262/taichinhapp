{
  "name": "tai-chinh",
  "productName": "Tai Chinh",
  "version": "1.0.2",
  "description": "Quản lý thu chi, 6 hũ tiết kiệm và kế hoạch đầu tư",
  "author": "Vũ Bình",
  "main": "main.cjs",
  "private": true,
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "vn.vubinh.taichinh",
    "productName": "Tai Chinh",
    "artifactName": "TaiChinh-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.cjs",
      "app/**/*",
      "resources/icon.png"
    ],
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.finance",
      "icon": "resources/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "extendInfo": {
        "CFBundleDisplayName": "Tài Chính",
        "LSApplicationCategoryType": "public.app-category.finance"
      }
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Tài Chính"
    },
    "afterPack": "./adhoc-sign.cjs"
  }
}