{
  "name": "tai-chinh",
  "productName": "Tài Chính",
  "version": "1.0.0",
  "description": "Quản lý thu chi, 6 hũ tiết kiệm và kế hoạch đầu tư",
  "author": "Vũ Bình",
  "main": "main.cjs",
  "private": true,
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "vn.vubinh.taichinh",
    "productName": "Tài Chính",
    "artifactName": "TaiChinh-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.cjs",
      "app/**/*",
      "build/icon.png"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.finance",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Tài Chính"
    },
    "afterPack": "./adhoc-sign.cjs"
  }
}