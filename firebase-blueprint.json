{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and sync metadata",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "lastSyncedAt": { "type": "number" }
      }
    },
    "UserPreference": {
      "title": "UserPreference",
      "description": "User preferences such as currency and UI settings",
      "type": "object",
      "properties": {
        "currency": {
          "type": "object",
          "properties": {
            "code": { "type": "string" },
            "symbol": { "type": "string" },
            "name": { "type": "string" },
            "locale": { "type": "string" }
          },
          "required": ["code", "symbol", "name", "locale"]
        },
        "updatedAt": { "type": "number" }
      }
    },
    "Account": {
      "title": "Account",
      "description": "Financial account of the user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { 
          "type": "string",
          "enum": ["CASH", "BANK", "EWALLET", "CREDIT", "INVESTMENT", "SAVINGS", "LOAN"]
        },
        "initialBalance": { "type": "number" },
        "color": { "type": "string" },
        "note": { "type": "string" },
        "icon": { "type": "string" }
      },
      "required": ["id", "name", "type", "initialBalance", "color"]
    },
    "Category": {
      "title": "Category",
      "description": "Income or expense category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["INCOME", "EXPENSE"]
        },
        "icon": { "type": "string" },
        "color": { "type": "string" },
        "isCustom": { "type": "boolean" }
      },
      "required": ["id", "name", "type", "icon", "color"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial transaction record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "amount": { "type": "number" },
        "type": {
          "type": "string",
          "enum": ["INCOME", "EXPENSE", "TRANSFER"]
        },
        "categoryId": { "type": "string" },
        "accountId": { "type": "string" },
        "toAccountId": { "type": "string" },
        "date": { "type": "string" },
        "note": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "amount", "type", "accountId", "date", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user root profile"
    },
    "/users/{userId}/settings/preferences": {
      "schema": "UserPreference",
      "description": "User preference settings"
    },
    "/users/{userId}/accounts/{accountId}": {
      "schema": "Account",
      "description": "User financial accounts"
    },
    "/users/{userId}/categories/{categoryId}": {
      "schema": "Category",
      "description": "User transaction categories"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "User financial transactions"
    }
  }
}
